# Run npm run setup:local to generate .env with separate random API/worker tokens.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://auto_forge:replace-with-a-random-local-password@127.0.0.1:55438/auto_forge
TEST_DATABASE_URL=postgresql://auto_forge:replace-with-a-random-local-password@127.0.0.1:55438/auto_forge_test
CONTROL_API_TOKEN=replace-with-a-unique-token-of-at-least-32-characters
WORKER_API_TOKEN=replace-with-a-different-token-of-at-least-32-characters
INTAKE_API_TOKEN=replace-with-a-third-token-of-at-least-32-characters
PORT=4318
WORKER_ID=local-simulation-worker
