{
  "name": "auto-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable, evidence-oriented engineering workflows. M1 simulation foundation.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node --env-file=.env --import tsx src/cli/migrate.ts",
    "dev": "node --env-file=.env --import tsx src/cli/server.ts",
    "worker": "node --env-file=.env --import tsx src/cli/worker.ts",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/contracts.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/integration.test.ts tests/http.test.ts",
    "verify": "npm run typecheck && node --check public/app.js && npm test && npm run test:integration && npm run build"
  },
  "dependencies": { "pg": "8.23.1", "zod": "4.6.6" },
  "devDependencies": { "@types/node": "22.20.5", "@types/pg": "8.23.1", "tsx": "4.23.15", "typescript": "7.0.2" }
}
