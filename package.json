{
  "name": "auto-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable, evidence-oriented engineering workflows. M2 bounded intake and simulation control plane.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "setup:intake": "node scripts/setup-intake-token.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node --env-file=.env --import tsx src/cli/migrate.ts",
    "dev": "node --env-file=.env --import tsx src/cli/server.ts",
    "worker": "node --env-file=.env --import tsx src/cli/worker.ts",
    "intake:once": "node --env-file=.env --import tsx src/cli/intake.ts --once",
    "intake:watch": "node --env-file=.env --import tsx src/cli/intake.ts --watch",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/contracts.test.ts tests/provider.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/integration.test.ts tests/http.test.ts tests/intake.test.ts",
    "verify": "npm run typecheck && node --check public/app.js && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
